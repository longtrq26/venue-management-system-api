# Application
APP_ENV=development
APP_URL=http://localhost
APP_PORT=3000

# API
API_PREFIX=api
API_VERSION=v1

# Client
CLIENT_URL=http://localhost:4200

# Database - Postgres
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=myapp_db
DB_USER=myapp_user
DB_PASSWORD=changeme123

# Authentication - JWT
AUTH_JWT_ISSUER=myapp
AUTH_JWT_AUDIENCE=myapp_users
AUTH_JWT_ACCESS_SECRET=accesssecret123
AUTH_JWT_ACCESS_EXPIRES_IN=15m
AUTH_JWT_REFRESH_SECRET=refreshsecret123
AUTH_JWT_REFRESH_EXPIRES_IN=7d

# Logger - Winston
LOG_LEVEL=info
LOG_DIRECTORY=logs
LOG_MAX_SIZE=20m
LOG_MAX_FILES=30d
LOG_DATE_PATTERN=DD-MM-YYYY
LOG_ZIPPED_ARCHIVE=true
LOG_CONSOLE_ENABLED=true
LOG_CONSOLE_COLORIZE=true

# Rate Limiting - Throttler
RATELIMIT_SHORT_TTL=60
RATELIMIT_SHORT_LIMIT=10
RATELIMIT_LONG_TTL=3600
RATELIMIT_LONG_LIMIT=100

# SMTP - Brevo
SMTP_API_KEY=SMTP_API_KEY_SAMPLE
SMTP_SENDER_EMAIL=sender@example.com

# Payment - PayOS
PAYMENT_CLIENT_ID=payment_client_id_sample
PAYMENT_API_KEY=payment_api_key_sample
PAYMENT_CHECKSUM_KEY=payment_checksum_key_sample
